@startuml
title Покупка участника программы лояльности

skinparam BackgroundColor #FFFFFF
skinparam DefaultFontName Segoe UI
skinparam DefaultFontSize 15
skinparam Shadowing false
skinparam ArrowColor #52647C

skinparam Activity {
  BackgroundColor #EDF4FC
  BorderColor #6484AC
  FontColor #142A44
  DiamondBackgroundColor #FFF4D8
  DiamondBorderColor #A98336
  DiamondFontColor #142A44
  StartColor #213A55
  EndColor #213A55
}

skinparam SwimlaneBorderColor #B5C3D5
skinparam SwimlaneTitleBackgroundColor #E9EFF6
skinparam SwimlaneTitleFontColor #142A44
skinparam SwimlaneTitleFontStyle bold

|Клиент|
|Кассир|
start
:Начать оформление покупки;
:Попросить идентификатор участника;

|Клиент|
:Сообщить идентификатор
(например, номер телефона);

|Кассир|
:Ввести идентификатор клиента
в систему платежей;

|Система платежей|
:Запросить данные клиента
по идентификатору;

|Система лояльности|
:Найти бонусный счёт клиента
и вернуть результат;

|Кассир|
:Уточнить, хочет ли клиент
списать баллы;

|Клиент|
:Сообщить решение по списанию;

|Кассир|
if (Клиент попросил списать баллы?) then (Да)
  :Выбрать списание и ввести
  количество баллов;

  |Система платежей|
  :Запросить резервирование баллов;

  |Система лояльности|
  if (Достаточно доступных баллов?) then (Да)
    :Зарезервировать баллы
    и вернуть сумму скидки;

    |Система платежей|
    :Применить скидку к чеку;
  else (Нет)
    |Система лояльности|
    :Передать ответ о нехватке баллов;

    |Кассир|
    :Сообщить клиенту о нехватке баллов;

    |Клиент|
    if (Продолжить без списания?) then (Да)
    else (Нет)
      |Кассир|
      :Прекратить оформление;
      stop
    endif
  endif
else (Нет)
  |Кассир|
  :Выбрать оплату без списания;
endif

|Система платежей|
if (Покупка отменена до оплаты?) then (Да)
  :Зафиксировать отмену;
else (Нет)
  :Передать платёж в банк
  и установить статус «В обработке»;
  :Дождаться итогового ответа банка
  о списании средств;
  :Зафиксировать оплату при успехе
  или отмену при отказе;
endif
:Передать подтверждение оплаты
или отмены в систему лояльности;

|Система лояльности|
if (Подтверждение уже обработано?) then (Да)
  :Вернуть прежний результат;
  stop
endif

if (Что подтверждено?) then (Оплата)
  #E8F5ED:Списать баллы из резерва, если он есть,
  начислить баллы за покупку
  и сохранить операцию в истории;
else (Отмена)
  :Освободить резерв, если он есть;
  stop
endif

|Клиент|
if (Клиент запросил возврат?) then (Да)
  |Система платежей|
  :Передать в банк запрос на возврат
  по исходной покупке;
  :Установить статус «Возврат в обработке»
  и дождаться итогового ответа банка;

  if (Банк подтвердил возврат?) then (Да)
    :Зафиксировать возврат и передать
    подтверждение в систему лояльности;

    |Система лояльности|
    :Вернуть баллы, списанные за возвращённые товары,
    и отменить начисленные за них баллы;
  else (Нет)
    |Система платежей|
    :Зафиксировать отказ в возврате;
  endif
endif
stop
@enduml