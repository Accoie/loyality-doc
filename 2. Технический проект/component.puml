@startuml
!include <C4/C4_Component>
!include <tupadr3/devicons/react>
!include <tupadr3/devicons/redis>
!include <tupadr3/devicons2/postgresql>
!include <logos/rabbitmq>

LAYOUT_TOP_DOWN()
scale max 4000 width
AddRelTag("delivery", $textColor="#174B8A", $lineColor="#174B8A", $legendText="Доставка из RabbitMQ")

Container(web, "Web Application", "React + TypeScript", "Личный кабинет и интерфейсы сотрудников", $sprite="react")
ContainerQueue(bus, "Event Bus", "RabbitMQ", "XML-сообщения и очереди подписчиков", $sprite="rabbitmq")

Container_Boundary(bonus, "Bonus Service") {
    Component(bonus_api, "Bonus Controller", "Controller", "Принимает запросы клиента на баланс и историю, а от администратора — на смену курса")
    Component(bonus_bus, "RabbitMQ Adapter", "Messaging Adapter", "Получает команды касс и отправляет результаты")
    Component(bonus_account, "Bonus Account Service", "Domain Service", "Показывает баланс и историю. Резервирует баллы до оплаты, начисляет и списывает после неё. Обрабатывает отмены и возвраты")
    Component(bonus_rates, "Points Rate Service", "Domain Service", "Меняет курс и записывает изменения в журнал. Завершённые покупки сохраняют свой курс")
    Component(bonus_store, "Bonus Repository", "Repository", "Сохраняет баланс и операцию вместе. Проверяет, была ли операция уже проведена")
}

Boundary(external, "External Services and Systems") {
    System_Ext(registration, "Registration and Access Service", "Регистрация, вход и настройки доступа")
    System_Ext(promotion, "Promotion Service", "Просмотр и управление акциями")
    System_Ext(analytics, "Analytics Service", "Отчёты и сегменты клиентов для менеджера")
    System_Ext(integration, "Integration Service", "Принимает операции POS и обменивается данными с CRM")
    System_Ext(notification, "Notification Service", "Доставка писем и уведомлений")
    System_Ext(pos1, "Store POS 1", "Покупки, возвраты и статус оплаты")
    System_Ext(pos2, "Store POS 2", "Покупки, возвраты и статус оплаты")
    System_Ext(pos3, "Store POS 3", "Покупки, возвраты и статус оплаты")
    System_Ext(crm, "CRM", "Клиенты и активность")
    System_Ext(provider, "Messaging Provider", "Доставка писем и уведомлений")
}

ContainerDb(postgres, "Shared Database", "PostgreSQL", "Отдельная схема каждого сервиса", $sprite="postgresql")
ContainerDb(redis, "Cache and Sessions", "Redis", "Кэш баланса и временные сессии", $sprite="redis")

Rel_D(web, registration, "Регистрация, вход и доступ", "HTTPS/XML")
Rel_D(web, bonus_api, "Баланс, история и курс", "HTTPS/XML")
Rel_D(web, promotion, "Акции", "HTTPS/XML")
Rel_D(web, analytics, "Отчёты и сегменты", "HTTPS/XML")

Rel_D(bus, bonus_bus, "Операции касс", "XML", $tags="delivery")
Rel_D(bus, analytics, "Покупки, возвраты, активность в CRM", "XML", $tags="delivery")
Rel_D(bus, integration, "Ответы для касс и данные для CRM", "XML", $tags="delivery")
Rel_D(bus, notification, "Уведомления для отправки", "XML", $tags="delivery")

Rel_U(registration, bus, "Запрос на подтверждение почты", "XML")
Rel_U(bonus_bus, bus, "Итоги операций", "XML")
Rel_U(promotion, bus, "События акций", "XML")
Rel_U(analytics, bus, "Обмен данными", "XML")
Rel_U(integration, bus, "Покупки, возвраты, оплата и данные CRM", "XML")

Rel_D(registration, postgres, "Хранит аккаунты и права", "SQL")
Rel_D(registration, redis, "Хранит сессии", "RESP")

Rel_D(bonus_api, bonus_account, "Запрашивает баланс и историю")
Rel_D(bonus_api, bonus_rates, "Меняет курс")
Rel_D(bonus_bus, bonus_account, "Передаёт операцию")
Rel_D(bonus_bus, bonus_store, "Читает результат операции")
Rel_D(bonus_account, bonus_rates, "Читает курс")
Rel_D(bonus_account, bonus_store, "Читает счёт и сохраняет операции")
Rel_D(bonus_account, redis, "Читает и сбрасывает кэш баланса", "RESP")
Rel_D(bonus_rates, bonus_store, "Сохраняет курс и аудит")
Rel_D(bonus_store, postgres, "Хранит баланс и операции", "SQL")

Rel_D(promotion, postgres, "Хранит акции", "SQL")
Rel_D(analytics, postgres, "Хранит показатели и сегменты", "SQL")
Rel_D(pos1, integration, "Покупки, возвраты и статус оплаты", "HTTPS/XML")
Rel_D(pos2, integration, "Покупки, возвраты и статус оплаты", "HTTPS/XML")
Rel_D(pos3, integration, "Покупки, возвраты и статус оплаты", "HTTPS/XML")
BiRel_D(crm, integration, "Профили и активность", "HTTPS/XML")
Rel_D(integration, postgres, "Хранит журнал обмена", "SQL")
Rel_D(notification, provider, "Отправляет письма и уведомления", "HTTPS/XML")
Rel_D(notification, postgres, "Хранит историю отправок", "SQL")

Lay_R(bonus, external)
@enduml
