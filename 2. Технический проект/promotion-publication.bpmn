<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Promotion" targetNamespace="urn:loyalty:promotion-publication" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.33.1">
  <bpmn:message id="Message_PromotionData" name="Данные акции" />
  <bpmn:message id="Message_ValidationError" name="Причина отказа" />
  <bpmn:message id="Message_PromotionCreated" name="Подтверждение создания" />
  <bpmn:message id="Message_PublishCommand" name="Команда публикации" />
  <bpmn:message id="Message_PromotionPublished" name="Подтверждение публикации" />
  <bpmn:collaboration id="Collaboration_Promotion" name="Создание и публикация акции">
    <bpmn:participant id="Participant_Loyalty" name="Создание и публикация акции" processRef="Process_Promotion" />
    <bpmn:participant id="Participant_0q5t6qs" name="Менеджер" processRef="Process_0h1001l" />
    <bpmn:messageFlow id="MessageFlow_Publish" name="Команда публикации" sourceRef="Task_ClickPublish" targetRef="Catch_PublishCommand" />
    <bpmn:messageFlow id="MessageFlow_Submit" name="Данные акции" sourceRef="Task_SubmitForm" targetRef="Start_PromotionData" />
    <bpmn:messageFlow id="MessageFlow_Published" name="Подтверждение публикации" sourceRef="End_Published" targetRef="Catch_PublicationConfirmed" />
    <bpmn:messageFlow id="MessageFlow_Created" name="Подтверждение создания" sourceRef="Throw_PromotionCreated" targetRef="Catch_CreationConfirmed" />
    <bpmn:messageFlow id="MessageFlow_Reject" name="Причина отказа" sourceRef="End_ValidationError" targetRef="Catch_ValidationRejected" />
    <bpmn:textAnnotation id="Annotation_Validation">
      <bpmn:text>Скидка больше 0% и не больше 100%.
Начало периода раньше окончания.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_Validation" sourceRef="Task_Validate" targetRef="Annotation_Validation" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Promotion" name="Создание и публикация акции" isExecutable="false">
    <bpmn:documentation>Система лояльности начинает процесс по запросу авторизованного менеджера по маркетингу. После отказа менеджер может исправить данные и отправить новый запрос. Опубликованная акция действует от начала до окончания заданного периода.</bpmn:documentation>
    <bpmn:startEvent id="Start_PromotionData" name="Получить данные акции">
      <bpmn:documentation>Запрос содержит название акции, товары, скидку и период действия.</bpmn:documentation>
      <bpmn:outgoing>Flow_ToValidation</bpmn:outgoing>
      <bpmn:messageEventDefinition id="EventDef_PromotionData" messageRef="Message_PromotionData" />
    </bpmn:startEvent>
    <bpmn:businessRuleTask id="Task_Validate" name="Проверить скидку и период">
      <bpmn:incoming>Flow_ToValidation</bpmn:incoming>
      <bpmn:outgoing>Flow_ToValidationResult</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Gateway_Valid" name="Скидка и период корректны?" gatewayDirection="Diverging" default="Flow_Invalid">
      <bpmn:incoming>Flow_ToValidationResult</bpmn:incoming>
      <bpmn:outgoing>Flow_Valid</bpmn:outgoing>
      <bpmn:outgoing>Flow_Invalid</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_ValidationError" name="Создание отклонено">
      <bpmn:incoming>Flow_Invalid</bpmn:incoming>
      <bpmn:messageEventDefinition id="EventDef_ValidationError" messageRef="Message_ValidationError" />
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_Save" name="Сохранить акцию">
      <bpmn:incoming>Flow_Valid</bpmn:incoming>
      <bpmn:outgoing>Flow_ToCreationNotice</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="Throw_PromotionCreated" name="Подтвердить создание">
      <bpmn:incoming>Flow_ToCreationNotice</bpmn:incoming>
      <bpmn:outgoing>Flow_ToPublishCommand</bpmn:outgoing>
      <bpmn:messageEventDefinition id="EventDef_PromotionCreated" messageRef="Message_PromotionCreated" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="Catch_PublishCommand" name="Получить команду публикации">
      <bpmn:documentation>Менеджер запрашивает публикацию сохранённой акции.</bpmn:documentation>
      <bpmn:incoming>Flow_ToPublishCommand</bpmn:incoming>
      <bpmn:outgoing>Flow_ToPublish</bpmn:outgoing>
      <bpmn:messageEventDefinition id="EventDef_PublishCommand" messageRef="Message_PublishCommand" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End_Published" name="Акция опубликована">
      <bpmn:incoming>Flow_ToAudit</bpmn:incoming>
      <bpmn:messageEventDefinition id="EventDef_Published" messageRef="Message_PromotionPublished" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_ToValidation" sourceRef="Start_PromotionData" targetRef="Task_Validate" />
    <bpmn:sequenceFlow id="Flow_ToValidationResult" sourceRef="Task_Validate" targetRef="Gateway_Valid" />
    <bpmn:sequenceFlow id="Flow_Valid" name="Да" sourceRef="Gateway_Valid" targetRef="Task_Save">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">0% &lt; скидка ≤ 100% и начало раньше окончания</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Invalid" name="Нет" sourceRef="Gateway_Valid" targetRef="End_ValidationError" />
    <bpmn:sequenceFlow id="Flow_ToCreationNotice" sourceRef="Task_Save" targetRef="Throw_PromotionCreated" />
    <bpmn:sequenceFlow id="Flow_ToPublishCommand" sourceRef="Throw_PromotionCreated" targetRef="Catch_PublishCommand" />
    <bpmn:sequenceFlow id="Flow_ToPublish" sourceRef="Catch_PublishCommand" targetRef="Task_Publish" />
    <bpmn:sequenceFlow id="Flow_ToAudit" sourceRef="Task_Publish" targetRef="End_Published" />
    <bpmn:serviceTask id="Task_Publish" name="Опубликовать акцию на заданный период">
      <bpmn:incoming>Flow_ToPublish</bpmn:incoming>
      <bpmn:outgoing>Flow_ToAudit</bpmn:outgoing>
    </bpmn:serviceTask>
  </bpmn:process>
  <bpmn:process id="Process_0h1001l" name="Работа менеджера по маркетингу с акцией" isExecutable="false">
    <bpmn:startEvent id="Start_Marketing">
      <bpmn:outgoing>ManagerFlow_Start</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_FillForm" name="Заполнить форму акции">
      <bpmn:documentation>Менеджер указывает название акции, товары, скидку и период действия.</bpmn:documentation>
      <bpmn:incoming>ManagerFlow_Start</bpmn:incoming>
      <bpmn:outgoing>ManagerFlow_Filled</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_MergeEdits" gatewayDirection="Converging">
      <bpmn:incoming>ManagerFlow_Filled</bpmn:incoming>
      <bpmn:incoming>ManagerFlow_Retry</bpmn:incoming>
      <bpmn:outgoing>ManagerFlow_Decide</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_Submit" name="Отправить данные акции?" gatewayDirection="Diverging" default="ManagerFlow_Cancel">
      <bpmn:incoming>ManagerFlow_Decide</bpmn:incoming>
      <bpmn:outgoing>ManagerFlow_Cancel</bpmn:outgoing>
      <bpmn:outgoing>ManagerFlow_Submit</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_MarketingCancelled" name="Менеджер отказался от создания акции">
      <bpmn:incoming>ManagerFlow_Cancel</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_SubmitForm" name="Отправить данные акции">
      <bpmn:incoming>ManagerFlow_Submit</bpmn:incoming>
      <bpmn:outgoing>ManagerFlow_Wait</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:eventBasedGateway id="Gateway_ValidationReply" name="Дождаться результата проверки" gatewayDirection="Diverging">
      <bpmn:incoming>ManagerFlow_Wait</bpmn:incoming>
      <bpmn:outgoing>ManagerFlow_Rejected</bpmn:outgoing>
      <bpmn:outgoing>ManagerFlow_Accepted</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="Catch_ValidationRejected" name="Получить причину отказа">
      <bpmn:incoming>ManagerFlow_Rejected</bpmn:incoming>
      <bpmn:outgoing>ManagerFlow_Correct</bpmn:outgoing>
      <bpmn:messageEventDefinition id="EventDef_Catch_ValidationRejected" messageRef="Message_ValidationError" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="Task_CorrectForm" name="Исправить данные акции">
      <bpmn:incoming>ManagerFlow_Correct</bpmn:incoming>
      <bpmn:outgoing>ManagerFlow_Retry</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="Catch_CreationConfirmed" name="Получить подтверждение создания">
      <bpmn:incoming>ManagerFlow_Accepted</bpmn:incoming>
      <bpmn:outgoing>ManagerFlow_Publish</bpmn:outgoing>
      <bpmn:messageEventDefinition id="EventDef_Catch_CreationConfirmed" messageRef="Message_PromotionCreated" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="Task_ClickPublish" name="Нажать «Опубликовать»">
      <bpmn:incoming>ManagerFlow_Publish</bpmn:incoming>
      <bpmn:outgoing>ManagerFlow_WaitPublication</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="Catch_PublicationConfirmed" name="Получить подтверждение публикации">
      <bpmn:incoming>ManagerFlow_WaitPublication</bpmn:incoming>
      <bpmn:outgoing>ManagerFlow_Done</bpmn:outgoing>
      <bpmn:messageEventDefinition id="EventDef_Catch_PublicationConfirmed" messageRef="Message_PromotionPublished" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End_MarketingPublished" name="Публикация подтверждена">
      <bpmn:incoming>ManagerFlow_Done</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="ManagerFlow_Start" sourceRef="Start_Marketing" targetRef="Task_FillForm" />
    <bpmn:sequenceFlow id="ManagerFlow_Filled" sourceRef="Task_FillForm" targetRef="Gateway_MergeEdits" />
    <bpmn:sequenceFlow id="ManagerFlow_Decide" sourceRef="Gateway_MergeEdits" targetRef="Gateway_Submit" />
    <bpmn:sequenceFlow id="ManagerFlow_Cancel" name="Нет" sourceRef="Gateway_Submit" targetRef="End_MarketingCancelled" />
    <bpmn:sequenceFlow id="ManagerFlow_Submit" name="Да" sourceRef="Gateway_Submit" targetRef="Task_SubmitForm">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Менеджер решил отправить данные акции</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="ManagerFlow_Wait" sourceRef="Task_SubmitForm" targetRef="Gateway_ValidationReply" />
    <bpmn:sequenceFlow id="ManagerFlow_Rejected" sourceRef="Gateway_ValidationReply" targetRef="Catch_ValidationRejected" />
    <bpmn:sequenceFlow id="ManagerFlow_Correct" sourceRef="Catch_ValidationRejected" targetRef="Task_CorrectForm" />
    <bpmn:sequenceFlow id="ManagerFlow_Retry" sourceRef="Task_CorrectForm" targetRef="Gateway_MergeEdits" />
    <bpmn:sequenceFlow id="ManagerFlow_Accepted" sourceRef="Gateway_ValidationReply" targetRef="Catch_CreationConfirmed" />
    <bpmn:sequenceFlow id="ManagerFlow_Publish" sourceRef="Catch_CreationConfirmed" targetRef="Task_ClickPublish" />
    <bpmn:sequenceFlow id="ManagerFlow_WaitPublication" sourceRef="Task_ClickPublish" targetRef="Catch_PublicationConfirmed" />
    <bpmn:sequenceFlow id="ManagerFlow_Done" sourceRef="Catch_PublicationConfirmed" targetRef="End_MarketingPublished" />
  </bpmn:process>
