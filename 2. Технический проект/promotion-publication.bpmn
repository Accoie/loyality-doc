        <bpmndi:BPMNLabel>
          <dc:Bounds x="585" y="226" width="20" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_ManagerFlow_Wait" bpmnElement="ManagerFlow_Wait">
        <di:waypoint x="745" y="248" />
