@startuml
title Контекстная диаграмма системы управления лояльностью

' C4 Context diagram
!includeurl https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

LAYOUT_LEFT_RIGHT()
SHOW_LEGEND()

Person(client, "Клиент", "Регистрируется, получает и использует бонусы, просматривает баланс, историю и акции")
Person(marketing, "Менеджер по маркетингу", "Создаёт акции, сегменты и отчёты по активности клиентов")
Person(admin, "Администратор", "Управляет ролями, блокировками и настройками программы")

System(loyalty, "Система управления лояльностью клиентов", "Регистрация и доступ, бонусные операции, акции, сегменты, отчёты и уведомления")

System_Ext(pos, "POS", "Передаёт покупки, возвраты и статус оплаты")
System_Ext(crm, "CRM", "Обменивается данными о клиентах и активности")

Rel(client, loyalty, "Использует личный кабинет")
Rel(marketing, loyalty, "Управляет акциями и аналитикой")
Rel(admin, loyalty, "Управляет доступом и настройками")

Rel(pos, loyalty, "Передаёт покупки, возвраты и статус оплаты")
Rel(loyalty, crm, "Обменивается данными")
@enduml
